manifest {
    name            = 'pd-proteome-mr-scan'
    description     = 'Proteome-wide cis-MR and colocalisation scan of plasma proteins against Parkinson\'s disease'
    author          = 'Salvatore Barbagallo'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10'
    version         = '0.1.0'
}

params {
    samplesheet      = null            // protein_id,gene,chr,start,end,exposure (GRCh38 gene bounds)
    outcome          = null            // PD GWAS, e.g. ieu-b-7.vcf.gz from OpenGWAS
    outcome_format   = 'opengwas_vcf'  // or 'generic'
    exposure_format  = 'ukbppp'        // UKB-PPP REGENIE files, or 'generic'
    ld_ref           = null            // PLINK prefix (GRCh37), e.g. 1000G EUR; omit -> lead-variant MR
    genes            = null            // optional comma-separated subset, e.g. 'GPNMB,LRRK2'
    outdir           = 'results'
    highlight        = 'GPNMB'

    window_kb        = 500
    info_min         = 0.8
    maf_min          = 0.01
    p_threshold      = 5e-8
    f_min            = 10
    clump_r2         = 0.001
    clump_kb         = 1000
    p1               = 1e-4
    p2               = 1e-4
    p12              = 1e-5
    fdr              = 0.05
    outcome_ncase    = 33674           // ieu-b-7 (Nalls et al. 2019, excluding 23andMe)
    outcome_ncontrol = 449056
}

env {
    PYTHONPATH = "${projectDir}/src"
}

process {
    cpus   = 1
    memory = '4 GB'
    withName: PREPARE_OUTCOME { memory = '8 GB' }
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries = 1
}

profiles {
    standard { executor.cpus = Runtime.runtime.availableProcessors() }
    docker {
        docker.enabled    = true
        process.container = 'pd-proteome-mr-scan:0.1.0'
    }
    conda {
        conda.enabled     = true
        process.conda     = "${projectDir}/environment.yml"
    }
    slurm { process.executor = 'slurm' }
    test {
        params.samplesheet = "${projectDir}/tests/data/samplesheet_test.csv"
        params.outcome     = "${projectDir}/tests/data/pd_outcome_test.vcf.gz"
        params.ld_ref      = "${projectDir}/tests/data/ld_ref/synthetic_eur_chr22"
        params.outdir      = 'results_test'
        process {
            memory = '2 GB'
            withName: PREPARE_OUTCOME { memory = '2 GB' }
        }
    }
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv"; overwrite = true }
